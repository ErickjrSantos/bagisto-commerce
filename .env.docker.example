# APPLICATION
APP_NAME=Bagisto
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_DEBUG_ALLOWED_IPS=
APP_URL=https://yourdomain.com
APP_ADMIN_URL=admin
APP_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DATABASE (These should be stored as secrets in CI/CD)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bagisto_production
DB_USERNAME=bagisto_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# CACHE
CACHE_STORE=redis
CACHE_PREFIX=bagisto_

# SESSION
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# QUEUE
QUEUE_CONNECTION=redis

# FILESYSTEM
FILESYSTEM_DISK=public

# MAIL (Store these as secrets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=shop@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_MAIL_ADDRESS=admin@yourdomain.com
ADMIN_MAIL_NAME=Admin

# RESPONSE CACHE
RESPONSE_CACHE_ENABLED=true

# ELASTICSEARCH
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# AWS (If using S3 - store as secrets)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DOCKER SPECIFIC
NGINX_PORT=80
NGINX_SSL_PORT=443
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M
VITE_PORT=5173

# MAILPIT (For development/testing only)
MAILPIT_PORT=1025
MAILPIT_DASHBOARD_PORT=8025
